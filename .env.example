# ---- Identity / keys ----
# Wallet that owns the Polymarket positions (used by demo-* and on-chain reads).
EOA_PRIVATE_KEY=
EOA_ADDRESS=

# Precommitted payout destination for every armed policy.
TREASURY_ADDRESS=

# ---- KeeperHub ----
# Org API key for remote execution (avatar -> API Keys -> Organisation in the app).
# Keys start with kh_. User keys (wfb_) authenticate webhooks and are not interchangeable.
KEEPERHUB_API_KEY=
KEEPERHUB_API_BASE=https://app.keeperhub.com

# ---- Chain ----
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
MIN_POL_BALANCE_FOR_GAS=0.01

# ---- Market selection (arm) ----
MARKET_ID=2252243 # Fed 25bps cut after September 2026 FOMC (resolves 2026-09-16)
POSITION_VALUE_USDC=100

# ---- Demo path ----
# Deterministic CTF condition created by demo-bootstrap (own-chain, own wallet).
# Tiny by design: run `pnpm demo-preflight` for the exact minimum funding first.
DEMO_AMOUNT_USDC=1
DEMO_COLLATERAL=USDC
DEMO_WINNER=YES